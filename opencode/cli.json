{
	"$schema": "https://opencode.ai/v2/cli.json",
	"diffs": {
		"wrap": "word"
	},
	"session": {
		"sidebar": "auto",
		"scrollbar": false,
		"thinking": "hide"
	},
	"animations": true,
	"theme": {
		"name": "tokyonight"
	},
	"attention": {
		"enabled": true,
		"notifications": true,
		"sound": true,
		"volume": 0.4,
		"sound_pack": "opencode.default"
	},
	"terminal": {
		"title": true,
		"copy": "select"
	}
}
