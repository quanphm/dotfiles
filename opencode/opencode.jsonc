{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "deepseek-v4-flash",
  "mcp": {
    "servers": {
      "traefik": {
        "type": "remote",
        "url": "https://mcp.skyanlabs.io/mcp",
        "enabled": true,
      },
    },
  },
  "websearch": {
    "provider": "exa",
  },
  "plugins": ["@plannotator/opencode@latest"],
  "permission": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow",
    },
  ],
}
