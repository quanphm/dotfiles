{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "deepseek-v4-flash",
  "mcp": {
    "traefik": {
      "type": "remote",
      "url": "https://mcp.skyanlabs.io/mcp",
      "enabled": true,
    },
  },
  "plugins": ["@plannotator/opencode@latest"],
  "permission": [{ "action": "skill", "resource": "*", "effect": "allow" }],
}
